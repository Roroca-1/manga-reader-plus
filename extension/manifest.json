{
  "manifest_version": 3,
  "name": "拷贝漫画增强阅读器",
  "version": "1.2.0",
  "description": "为拷贝漫画（mangacopy.com 及镜像站）打造的桌面级阅读器：悬浮工具栏、单页/双页/条漫、翻页方向、画面适配与缩放、页面总览与完整快捷键。",
  "content_scripts": [
    {
      "matches": [
        "*://*.mangacopy.com/comic/*/chapter/*",
        "*://*.copymanga.tv/comic/*/chapter/*",
        "*://*.copymanga.site/comic/*/chapter/*",
        "*://*.copymanga.org/comic/*/chapter/*",
        "*://*.2025copy.com/comic/*/chapter/*",
        "*://*.2026copy.com/comic/*/chapter/*"
      ],
      "js": ["reader.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
