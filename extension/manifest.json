{
  "manifest_version": 3,
  "name": "网页漫画增强阅读器",
  "version": "1.3.3",
  "description": "桌面级网页漫画增强阅读器：悬浮工具栏、单页/双页/条漫、翻页方向、画面适配与缩放、页面总览与完整快捷键。",
  "content_scripts": [
    {
      "matches": [
        "*://*.mangacopy.com/comic/*/chapter/*",
        "*://*.copymanga.tv/comic/*/chapter/*",
        "*://*.copymanga.site/comic/*/chapter/*",
        "*://*.copymanga.org/comic/*/chapter/*",
        "*://*.copymanga.net/comic/*/chapter/*",
        "*://*.copymanga.com/comic/*/chapter/*",
        "*://*.2024copy.com/comic/*/chapter/*",
        "*://*.2025copy.com/comic/*/chapter/*",
        "*://*.2026copy.com/comic/*/chapter/*",
        "*://nhentai.net/*",
        "*://*.nhentai.net/*",
        "*://*.nhentai.to/g/*",
        "*://*.nhentai.xxx/g/*",
        "*://*.nhentai.website/g/*",
        "*://*.18comic.vip/photo/*",
        "*://*.18comic.org/photo/*",
        "*://*.18comic.ink/photo/*",
        "*://*.18comic.biz/photo/*",
        "*://*.18comic.tw/photo/*",
        "*://*.jmcomic.me/photo/*",
        "*://*.jmcomic1.me/photo/*",
        "*://*.jm-comic.cc/photo/*",
        "*://*.jm-comic1.cc/photo/*",
        "*://*.jm-comic2.cc/photo/*",
        "*://*.jm-comic3.cc/photo/*",
        "*://*.zerobyw33.com/*",
        "*://*.zerobyw.com/*"
      ],
      "js": ["reader.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
